{
  "folders": [{ "path": ".", "name": "plasma-mcp" }],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": ["tests"],
    "files.exclude": { "**/__pycache__": true, "*.egg-info": true, ".pytest_cache": true },
    "search.exclude": { "reference/cmc": true, ".venv": true },
    "editor.rulers": [100],
    "[python]": { "editor.tabSize": 4 }
  },
  "extensions": {
    "recommendations": ["ms-python.python", "ms-python.vscode-pylance", "ms-python.debugpy", "charliermarsh.ruff"]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      { "label": "Setup: venv + deps", "type": "shell", "command": "uv venv --allow-existing && uv pip install -e '.[dev]'", "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] },
      { "label": "Test", "type": "shell", "command": ".venv/bin/python -m pytest -q", "options": { "cwd": "${workspaceFolder}" }, "group": { "kind": "test", "isDefault": true }, "problemMatcher": [] },
      { "label": "Run", "type": "shell", "command": ".venv/bin/python -m plasma_mcp.server", "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      { "name": "Debug: tests", "type": "debugpy", "request": "launch", "module": "pytest", "args": ["-q"], "cwd": "${workspaceFolder}" }
    ]
  }
}
